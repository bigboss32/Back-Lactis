# =============================================================================
#  Variables de entorno del backend (Quesera ERP / Lactis)
#  Copia este archivo como .env y ajusta los valores.  →  cp .env.example .env
#  El archivo .env NO se sube al repositorio (está en .gitignore).
# =============================================================================

# ---- Aplicación ----
PROJECT_NAME=Quesera ERP
VERSION=1.0.0
# development | production   (en production se ocultan detalles y tokens de dev)
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ---- Base de datos (PostgreSQL) ----
# Local (sin Docker), Postgres en el puerto 5433:
DATABASE_URL=postgresql+psycopg2://quesera:quesera@localhost:5433/quesera_erp
# Dentro de Docker Compose el host es el nombre del servicio "db" y el puerto 5432:
# DATABASE_URL=postgresql+psycopg2://quesera:quesera@db:5432/quesera_erp

# ---- Seguridad / JWT ----
# ⚠️ CÁMBIALA en producción por una cadena larga y aleatoria (32+ caracteres).
#    Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-en-produccion-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Intentos de login fallidos antes de bloquear la cuenta
MAX_LOGIN_ATTEMPTS=5

# ---- CORS (orígenes del frontend permitidos) ----
# Debe ir en formato lista JSON (comillas dobles). Añade el dominio real en producción.
CORS_ORIGINS=["http://localhost:4200","http://localhost:8000","http://localhost:5000"]

# ---- Archivos subidos (logos, fotos, adjuntos de gastos) ----
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Usuario administrador inicial (se crea en el primer arranque / seed) ----
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin123*
FIRST_ADMIN_EMAIL=admin@quesera.local

# ---- Datos de demostración ----
# true  = siembra empresa demo "Queso La Marginal de la Selva" con proveedores, etc.
# false = solo crea permisos, roles y el superadmin (recomendado en producción).
SEED_DEMO_DATA=true

# ---- Suscripción mensual (pasarela Wompi) ----
# ⚠️ Las llaves REALES van solo en el .env local (gitignored) o en el dashboard
#    del hosting. Aquí SOLO placeholders. Se obtienen en https://comercios.wompi.co
# Sandbox: https://sandbox.wompi.co/v1 — Producción: https://production.wompi.co/v1
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
# A dónde vuelve la persona después de pagar por PSE en su banco
WOMPI_REDIRECT_URL=https://lactis.app/suscripcion
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENT_SECRET=test_events_xxx
# Tarifa mensual por defecto en COP (el superadmin puede fijar tarifa por empresa)
SUSCRIPCION_TARIFA_DEFAULT=100000
# Días de gracia tras el vencimiento antes de bloquear, y días de aviso previo
SUSCRIPCION_DIAS_GRACIA=5
SUSCRIPCION_DIAS_AVISO=5
# Días de prueba para empresas nuevas (sin pagos todavía)
SUSCRIPCION_DIAS_PRUEBA=30
# Secreto del header X-Cron-Secret para POST /suscripcion/cobrar-vencidas
# (vacío = el endpoint queda deshabilitado)
SUSCRIPCION_CRON_SECRET=

# ---- Adjuntos de reventa en Cloudflare R2 (soportes de transferencia) ----
# ⚠️ Las llaves REALES van solo en el .env local (gitignored) o en el dashboard
#    del hosting (Render). Aquí SOLO placeholders, igual que con Wompi.
#    Se crean en el panel de Cloudflare → R2 → Manage API Tokens.
#
# Los archivos quedan PRIVADOS: no se guarda ni se sirve ninguna URL pública.
# Para ver una imagen el backend firma un enlace corto; para compartirla por
# WhatsApp, uno más largo.
#
# Si estas variables quedan VACÍAS la app arranca igual y TODO el módulo de
# reventa funciona; lo único que avisa que no está disponible es la parte de
# adjuntos.
R2_ENDPOINT_URL=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.cloudflarestorage.com
R2_BUCKET=lactis
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2 no maneja regiones como AWS: su cliente S3 espera literalmente "auto".
R2_REGION=auto
# Minutos que vive el enlace de VER (el de la pantalla)
R2_URL_VER_MINUTOS=15
# Días que vive el enlace de COMPARTIR (el que se manda por WhatsApp).
# Máximo 7: es el tope duro de una URL firmada con SigV4.
R2_URL_COMPARTIR_DIAS=7
# Tamaño máximo por archivo adjunto, en MB (una foto de celular pesa varios)
ADJUNTOS_MAX_MB=15
# Cuántos soportes caben en una misma compra o venta
ADJUNTOS_MAX_POR_DOCUMENTO=20
